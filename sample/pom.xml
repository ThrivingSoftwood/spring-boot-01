<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>thriving.softwood</groupId>
        <artifactId>spring-boot-01</artifactId>
        <version>0.0.5</version>
    </parent>
    <artifactId>sample</artifactId>
    <name>sample</name>
    <description>应用示例</description>
    <properties>
        <java.version>${jdk.version}</java.version>
    </properties>

    <dependencies>
        <!--00.项目内依赖 begin-->
        <dependency>
            <groupId>thriving.softwood.common</groupId> <!-- 注意这里是 common -->
            <artifactId>common-web</artifactId>
        </dependency>
        <!-- ✨ 引入刚建好的数据库底座 -->
        <dependency>
            <groupId>thriving.softwood.common</groupId>
            <artifactId>common-database</artifactId>
        </dependency>
        <!--00.项目内依赖 end-->

        <!--01.日志实现依赖 begin-->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-layout-template-json</artifactId>
        </dependency>
        <!--01.日志实现依赖 end-->

        <!--02.开发辅助依赖 begin-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ✨ 显式指定具体使用的数据库驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>
        <!--02.开发辅助依赖 end-->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 🌟 新增 configuration 配置 -->
                <configuration>
                    <!-- 🚀 核心魔法：告诉 Spring Boot 启动时将国密 BC 库解压到系统物理磁盘临时目录，绕过嵌套 Jar 的原生签名校验 Bug -->
                    <requiresUnpack>
                        <dependency>
                            <groupId>org.bouncycastle</groupId>
                            <artifactId>bcprov-jdk18on</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
            </plugin>
        </plugins>
        <finalName>${project.artifactId}-sample</finalName>
    </build>

</project>