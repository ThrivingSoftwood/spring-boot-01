<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="thriving.softwood.customer.first.infrastructure.db.edongfang.mapper.extend.EdongfangLogisticsExtendMapper">


    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="thriving.softwood.customer.first.biz.pojo.dto.EdongfangLogisticDTO">
        <id column="pk" property="pk"/>
        <result column="stub_id" property="stubId"/>
        <result column="e_order_id" property="eOrderId"/>
        <result column="logistics_state" property="logisticsState"/>
        <result column="submit_state" property="submitState"/>
        <result column="package_id" property="packageId"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="cu" property="cu"/>
        <result column="order_price" property="orderPrice"/>
        <result column="order_type" property="orderType"/>
        <result column="express_company" property="expressCompany"/>
        <result column="express_no" property="expressNo"/>
        <result column="invoice_no" property="invoiceNo"/>
        <result column="invoice_code" property="invoiceCode"/>
        <result column="type" property="type"/>
        <result column="receive_time" property="receiveTime"/>
    </resultMap>

    <select id="listUnnotified" resultMap="BaseResultMap">
        select b.id as stub_id, a.e_order_id, a.receive_time, a.order_price, a.express_company, a.express_no
        from edongfang_logistics as a,
             edongfang_order_stub as b
        where a.e_order_id &lt;= #{maxOrderId}
          and a.e_order_id = b.e_order_id
          and a.receive_time is not null
          and (b.last_receive_time is null or a.receive_time &lt;&gt; b.last_receive_time)
        order by a.e_order_id
    </select>
</mapper>
